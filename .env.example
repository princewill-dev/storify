APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POS_TOKEN_EXPIRY_MINUTES=480
POS_IDLE_TIMEOUT_MINUTES=15
POS_LINK=https://pos.storify.ng

# Digital product uploads (KB). Also raise PHP upload_max_filesize/post_max_size to match.
DIGITAL_UPLOAD_MAX_KB=102400

# Standalone frontends (comma-separated origins). When set, CORS credentials are enabled.
API_ALLOWED_ORIGINS=

# Regex origin patterns for wildcard store subdomains (comma-separated).
#
# Each entry must be a COMPLETE regex, delimiters included — Laravel passes it
# straight to preg_match(). "#...#" is the safe delimiter here because the
# patterns contain slashes. An undelimited entry is wrapped automatically, but
# write the delimiters anyway so the value reads as what it is.
#
# Both storefront and platform origins have to be listed, and they are on
# different domains: stores are served from {slug}.storify.buzz, everything
# else from *.storify.ng. The last pattern is the Electron POS "null" origin.
#
# Production example:
# API_ALLOWED_ORIGINS=https://storify.ng
# API_ALLOWED_ORIGIN_PATTERNS=#^https://[a-z0-9-]+\.storify\.buzz$#,#^https://[a-z0-9-]+\.storify\.ng$#,#^null$#
#
# Keep API_ALLOWED_ORIGINS empty for the default wildcard during development.
#
# Keep at least one pattern in production. With origins set but no patterns,
# the handler treats a lone API_ALLOWED_ORIGINS entry as "the" origin and
# echoes it for every request — rejecting app/admin/pos subdomains.
API_ALLOWED_ORIGIN_PATTERNS=

# API token lifetimes (minutes / days)
API_MANAGEMENT_ACCESS_TTL=120
API_MANAGEMENT_REFRESH_TTL=30
API_ADMIN_ACCESS_TTL=120
API_ADMIN_REFRESH_TTL=14
API_CUSTOMER_ACCESS_TTL=240
API_CUSTOMER_REFRESH_TTL=30

# ── Standalone frontends ────────────────────────────────────────────
# This app is API-only; the UI lives in separate Vue applications. Anything
# that links back to one (invitation and password-reset mails, download and
# order-tracking links) resolves through config/frontend.php.
#
# Leave these empty to derive conventional hosts from APP_MAIN_DOMAIN:
#   management  -> app.<domain>      admin -> office.<domain>
#   home        -> <domain>
#
# The storefronts are the exception: they are on their own domain, so
# <store slug>.<STOREFRONT_MAIN_DOMAIN> rather than <store slug>.<domain>.
# Leave STOREFRONT_MAIN_DOMAIN unset to fall back to storify.buzz.
#
# Set STOREFRONT_URL only for a single-store deployment, where every store
# shares one origin instead of its own subdomain. It drops the slug, so it is
# wrong for anything multi-store.
STOREFRONT_MAIN_DOMAIN=storify.buzz
MANAGEMENT_SPA_URL=
ADMIN_SPA_URL=
HOME_URL=
STOREFRONT_URL=
