APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

POS_TOKEN_EXPIRY_MINUTES=480
POS_IDLE_TIMEOUT_MINUTES=15
POS_LINK=https://pos.storify.ng

# Digital product uploads (KB). Also raise PHP upload_max_filesize/post_max_size to match.
DIGITAL_UPLOAD_MAX_KB=102400

# Standalone frontends (comma-separated origins). When set, CORS credentials are enabled.
API_ALLOWED_ORIGINS=

# Regex origin patterns for wildcard store subdomains (comma-separated).
#
# Write the patterns WITHOUT regex delimiters — CorsOriginPatterns::normalise()
# wraps each one. That is not just a convenience: dotenv reads a leading "#" as
# an inline comment, so a delimited entry written bare in a .env parses to an
# EMPTY string and every storefront origin is silently rejected. Single-quoting
# a "#...#" value does work, and double-quoting one is a hard parse failure
# ("unexpected escape sequence" on the "\."). Leaving the delimiters off
# sidesteps all of it and is the form to use.
#
# Storefront and platform origins both have to be listed. The two patterns
# below are not redundant: stores are served from {slug}.storify.ng now, but
# every link already published on the older {slug}.storify.buzz domain still
# has to be reachable, so both stay. The last pattern is the Electron POS
# "null" origin.
#
# Production example:
# API_ALLOWED_ORIGINS=https://storify.ng
# API_ALLOWED_ORIGIN_PATTERNS=^https://[a-z0-9-]+\.storify\.buzz$,^https://[a-z0-9-]+\.storify\.ng$,^null$
#
# Keep API_ALLOWED_ORIGINS empty for the default wildcard during development.
#
# Keep at least one pattern in production. With origins set but no patterns,
# the handler treats a lone API_ALLOWED_ORIGINS entry as "the" origin and
# echoes it for every request — rejecting app/admin/pos subdomains.
API_ALLOWED_ORIGIN_PATTERNS=

# API token lifetimes (minutes / days)
API_MANAGEMENT_ACCESS_TTL=120
API_MANAGEMENT_REFRESH_TTL=30
API_ADMIN_ACCESS_TTL=120
API_ADMIN_REFRESH_TTL=14
API_CUSTOMER_ACCESS_TTL=240
API_CUSTOMER_REFRESH_TTL=30

# ── Bachs (platform billing gateway) ────────────────────────────────
# The Bachs account Storify itself charges through, when an admin has
# selected Bachs as the platform's billing gateway (Admin → Settings →
# Payment Methods). This is not a merchant's credentials: a business that
# connects Bachs stores its own keys, encrypted, against its own row, and
# is unaffected by anything here.
#
# BACHS_BASE_URL is the Bachs host every call goes to, and it is the whole of
# the sandbox/live decision. It is not derived from the key's prefix and not
# from APP_ENV: one value, one place to read it off.
#   live      https://api.bachs.io/v1
#   sandbox   https://sandbox-api.bachs.io/v1
# Empty or unset means the live host, and that default is deliberate — a
# sandbox key against live is refused with a 401, while a live key against
# sandbox is a charge that never happens and reports nothing.
#
# It is platform-wide, so it covers a business's own connected Bachs account as
# well as the one above: pointing it at sandbox points every business there.
#
# BACHS_WEBHOOK_SECRET is the *signing secret of a webhook endpoint* created
# in the Bachs dashboard, not an API key. It is not the same value as
# BACHS_API_KEY, and pasting the API key here rejects every delivery. Left
# empty, subscription activation still works, but only while the customer's
# browser makes it back to the callback — the webhook is what covers the
# customer who pays and then closes the tab.
#
# That endpoint is:
#   POST {APP_URL}/webhooks/subscription/bachs
# Create it in the Bachs dashboard and paste its signing secret below. Without
# it a subscription settles only on the browser's return leg, so a customer who
# pays and closes the tab stays unsubscribed until somebody notices.
#
# Both are read at request time, so changing them needs `config:clear`.
#
# Left as placeholders on purpose. This file is committed, and the repository
# is public: a sandbox key pasted here is a live key to anyone who reads it,
# and a webhook signing secret pasted here lets anyone forge a delivery that
# this application will believe. Real values belong in `.env`, which is not
# tracked.
BACHS_API_KEY=
BACHS_BASE_URL=
BACHS_WEBHOOK_SECRET=
#
# ── Bachs Connect (businesses paid through Storify) ─────────────────
# The same API key takes payments on a business's behalf: a sale is charged
# on the platform's key with the business's connected account attached, so
# the money lands in *their* account at Bachs and is paid out to their bank.
# Nothing extra is configured for that, and no business's keys are involved.
#
# One endpoint receives those deliveries and the payout outcomes:
#   POST {APP_URL}/webhooks/connect/bachs
# It must be created in the Bachs dashboard with `event_source: connect` (or
# `all`). Connected-account events are not sent to a merchant endpoint, so the
# per-store webhook URLs shown in the management panel will never receive them.
#
# BACHS_CONNECT_WEBHOOK_SECRET is that endpoint's signing secret. Leave it
# empty unless Bachs issues a different one for the connect endpoint — unset,
# it falls back to BACHS_WEBHOOK_SECRET above, which is the case to expect.
# Without it, connected-account sales settle only when the customer's browser
# returns to the callback, and payouts are not tracked back at all.
# BACHS_CONNECT_WEBHOOK_SECRET=

# ── Standalone frontends ────────────────────────────────────────────
# This app is API-only; the UI lives in separate Vue applications. Anything
# that links back to one (invitation and password-reset mails, download and
# order-tracking links) resolves through config/frontend.php.
#
# Leave these empty to derive conventional hosts from APP_MAIN_DOMAIN:
#   management  -> app.<domain>      admin -> office.<domain>
#   home        -> <domain>
#
# Storefronts are <store slug>.<STOREFRONT_MAIN_DOMAIN>, which now defaults to
# the main domain. It is a key of its own rather than a reuse of
# APP_MAIN_DOMAIN, so a deployment publishing stores on another domain
# overrides just this one.
# Leave STOREFRONT_MAIN_DOMAIN unset to fall back to storify.ng.
#
# Set STOREFRONT_URL only for a single-store deployment, where every store
# shares one origin instead of its own subdomain. It drops the slug, so it is
# wrong for anything multi-store.
STOREFRONT_MAIN_DOMAIN=storify.ng
MANAGEMENT_SPA_URL=
ADMIN_SPA_URL=
HOME_URL=
STOREFRONT_URL=
